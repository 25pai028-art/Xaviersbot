# =====================================================================
#  Xavier's Assistant — configuration
#  Copy to `.env` and adjust. `.env` is git-ignored: never commit secrets.
#  Every value here is optional; the defaults are shown.
# =====================================================================

# ---------------------------------------------------------------- General
APP_NAME=Xavier's Assistant
# development | production (production hides /api/docs)
ENVIRONMENT=development
# Where SQLite, ChromaDB and model caches live
# DATA_DIR=./data
LOG_LEVEL=INFO

# ---------------------------------------------------------------- LLM
# Which LLM answers questions. Switching needs only this file + a restart;
# embeddings stay local, so no re-indexing is ever needed.
#   ollama    – local, free, CPU-friendly (default, development)
#   gemini    – Google Gemini API free tier (fast free option for development)
#   anthropic – Claude API (production)
#   openai    – optional, OpenAI or any OpenAI-compatible endpoint
LLM_PROVIDER=ollama
# 0–0.2 keeps answers factual (ignored by Claude models that don't accept sampling parameters)
LLM_TEMPERATURE=0.1
# Short answers are faster on CPU (~9 tokens/s with qwen3.5:4b)
LLM_MAX_OUTPUT_TOKENS=400
LLM_TIMEOUT_SECONDS=180

# --- Ollama (local) ---
# Pick the model by RAM (CPU-only, Q4_K_M quantisation — Ollama's default tags):
#   8 GB RAM  -> qwen3.5:2b      (~2.7 GB download)  or phi4-mini
#   16 GB RAM -> qwen3.5:4b      (~3.4 GB)  <- default for the dev laptop (i5-13500H, 16 GB)
#                qwen3.5:9b      (~6.6 GB)  better answers, ~2x slower
#   32 GB RAM -> qwen3.5:35b-a3b (MoE, only ~3B active params: runs well on CPU)
# Install with: ollama pull qwen3.5:4b
# Fallback if a download fails: qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Context window; ~8K is plenty for top-4 chunks + short history and keeps CPU RAM use modest
OLLAMA_NUM_CTX=8192
# Keep the model loaded between questions (avoids a 10–30 s reload)
OLLAMA_KEEP_ALIVE=30m

# --- Google Gemini (free tier) ---
# Key from https://aistudio.google.com/apikey. Note: free-tier prompts may be used by Google
# to improve its products; only public college content + user questions are sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no "thinking" (fastest); -1 = model default
GEMINI_THINKING_BUDGET=0

# --- Anthropic Claude (production) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5   – most capable ($4 / $20 per million input/output tokens)
# claude-sonnet-5-5 – balanced ($2 / $10)
# claude-haiku-4-5  – cheapest and fastest ($1 / $5)
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning depth for Opus/Sonnet 5.x: low | medium | high. "low" is right for short factual answers.
ANTHROPIC_EFFORT=low

# --- OpenAI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Leave empty for api.openai.com; set for OpenAI-compatible servers
OPENAI_BASE_URL=

# ---------------------------------------------------------------- Embeddings & retrieval
# Multilingual embeddings, always run locally (first use downloads ~2.3 GB)
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=1024
# Changing chunk sizes needs: python -m scripts.crawl --reindex
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
# Chunks sent to the LLM (3 on CPU; 4–6 with a paid API)
RETRIEVAL_TOP_K=3
# Upper limit on context tokens per question. On CPU the model reads ~40 tokens/s,
# so 1100 tokens ≈ 25 s before the first word. Raise to 3000+ with Gemini/Claude.
MAX_CONTEXT_TOKENS=1100
# Relevance grade (cosine similarity + bonus for exact keyword matches) the best chunk must reach.
# Below it the bot says "I don't have that information" WITHOUT calling the LLM.
SIMILARITY_THRESHOLD=0.5
# When retrieval is weak, let the LLM rewrite the question into a better search query (one retry)
RAG_QUERY_REWRITE=true
# Replace answers containing fees/numbers/phones/emails/URLs that are not in the sources
FACT_CHECK_ENABLED=true
# Second AI pass that removes sentences the sources don't state (+15-30 s per answer on a laptop CPU)
GROUNDING_CHECK=true
# Official channel offered when refusing cheating / hacking / forgery requests
GUARD_EXAM_OFFICE_CONTACT=Examination Office (coe@sxca.edu.in, 079-26308055)
# Previous question/answer pairs sent for follow-up questions
CHAT_HISTORY_TURNS=3

# ---------------------------------------------------------------- Crawler
# Comma-separated lists
CRAWL_START_URLS=https://sxca.edu.in/,http://library.sxca.edu.in/,https://admissions.sxca.edu.in/
CRAWL_ALLOWED_DOMAINS=sxca.edu.in,admissions.sxca.edu.in,library.sxca.edu.in
# Login portals / ERP — never crawled
CRAWL_BLOCKED_DOMAINS=lms.sxca.edu.in,portal.sxca.edu.in,erp.sxca.edu.in
# Public Google Drive PDFs linked from college pages
CRAWL_INCLUDE_GOOGLE_DRIVE=true
CRAWL_MAX_PAGES=5000
CRAWL_MAX_DEPTH=6
CRAWL_MAX_FILE_MB=25
# Parallel downloads; requests to one host start at least CRAWL_DELAY_SECONDS apart
CRAWL_CONCURRENCY=4
CRAWL_DELAY_SECONDS=0.25
CRAWL_TIMEOUT_SECONDS=30
# Skip /wp-content/uploads/YYYY/ files older than this year
CRAWL_MIN_UPLOAD_YEAR=2025
CRAWL_USER_AGENT=SXCA-Chatbot-Crawler/1.0 (+https://sxca.edu.in/; official college assistant)
# Render pages with headless Chromium when plain HTML has little text (run: playwright install chromium)
CRAWL_USE_PLAYWRIGHT=true
CRAWL_PLAYWRIGHT_MIN_CHARS=200
# Max scanned pages OCR'd per PDF (OCR is slow on CPU)
CRAWL_OCR_MAX_PAGES=15
# OCR scanned PDFs / image notices in a separate pass at the end, so everything else is usable sooner
CRAWL_DEFER_OCR=true

# ---------------------------------------------------------------- OCR (Tesseract)
OCR_LANGUAGES=eng+hin+guj
# Full path if tesseract is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------------------------------------------------------------- API
# Sites allowed to call the chat API from a browser
CORS_ORIGINS=https://sxca.edu.in,http://localhost:8000
MAX_MESSAGE_CHARS=1000

# ---------------------------------------------------------------- Chat widget
# Colours are CSS variables that the college website can override (see README).
# Welcome message; empty = the standard greeting.
WIDGET_WELCOME=
# Languages in the selector (codes: en,hi,gu,ml,ta,te,kn,mr,bn,pa,or,ur). The selector is hidden while only one is listed.
WIDGET_LANGUAGES=en,hi,gu,ml,ta,te,kn,mr,bn,pa,or,ur
# Logo URL; empty = the college crest served by this server.
WIDGET_LOGO_URL=
# Shown as "Contact the college office" buttons when the bot can't answer.
COLLEGE_OFFICE_URL=https://sxca.edu.in/contact-us/
COLLEGE_OFFICE_EMAIL=info@sxca.edu.in
COLLEGE_OFFICE_PHONE=079-29708056/7

# ---------------------------------------------------------------- Languages
# auto = the chat LLM translates, with IndicTrans2 (local, see README) as the backup when a translation
# fails the checks. Other values: llm | indictrans2 | off (answers stay in English).
TRANSLATION_PROVIDER=auto

# ---------------------------------------------------------------- Official (verified) answers
# How close a question must be to an official Q&A (cosine similarity of meaning).
# Above DIRECT the official answer is given word for word (no LLM); above CONTEXT it is
# given to the LLM as the most important source.
VERIFIED_DIRECT_THRESHOLD=0.86
VERIFIED_CONTEXT_THRESHOLD=0.72

# ---------------------------------------------------------------- Admin panel
# Create the first admin with: python -m scripts.create_admin
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
UPLOAD_MAX_MB=20
# Unanswered / thumbs-down question texts are deleted after this many days
RETENTION_DAYS=30

# ---------------------------------------------------------------- Background jobs
SCHEDULER_ENABLED=true
# Automatic incremental re-crawl: day (mon..sun, or * for daily) and hour (server local time)
CRAWL_SCHEDULE_DAY=sun
CRAWL_SCHEDULE_HOUR=2

# ---------------------------------------------------------------- Paid LLM cost estimate
# USD per million tokens. Leave 0 to use built-in prices for known Claude models.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
